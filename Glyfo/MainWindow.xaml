<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Glyfo.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Glyfo"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Glyfo">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <!-- Every user-visible string here is assigned from the string tables in ApplyLanguage(), so
         that switching language takes effect without rebuilding the window. Nothing in this file
         carries display text of its own. -->
    <Grid x:Name="RootGrid">
        <Grid.Resources>
            <Style x:Key="CardBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
            <Style x:Key="CardToolbarStyle" TargetType="Border">
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="Padding" Value="8,6" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- title bar -->
        <Grid x:Name="AppTitleBar" Height="40" Padding="14,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE721;" FontSize="14" />
                <TextBlock Text="Glyfo" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                <TextBlock x:Name="EngineStatusText"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- two panes -->
        <Grid Grid.Row="1" Margin="14,4,14,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- left: image preview -->
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer x:Name="PreviewScrollViewer"
                                  ZoomMode="Enabled"
                                  MinZoomFactor="0.1"
                                  MaxZoomFactor="8"
                                  HorizontalScrollMode="Auto"
                                  VerticalScrollMode="Auto"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalContentAlignment="Center"
                                  VerticalContentAlignment="Center"
                                  ViewChanged="PreviewViewChanged"
                                  SizeChanged="PreviewSizeChanged"
                                  AllowDrop="True"
                                  DragOver="PreviewDragOver"
                                  Drop="PreviewDrop"
                                  CornerRadius="8,8,0,0">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Image x:Name="PreviewImage" Stretch="None" Visibility="Collapsed" />
                            <StackPanel x:Name="PreviewPlaceholder"
                                        Spacing="10"
                                        Padding="24"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE91B;" FontSize="30"
                                          Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <TextBlock x:Name="PreviewPlaceholderText"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>

                    <Border Grid.Row="1" Style="{StaticResource CardToolbarStyle}" BorderThickness="0,1,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Button x:Name="CopyImageButton" Click="CopyImageClick">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <SymbolIcon Symbol="Copy" />
                                    <TextBlock x:Name="CopyImageLabel" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="SaveImageButton" Click="SaveImageClick">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <SymbolIcon Symbol="Save" />
                                    <TextBlock x:Name="SaveImageLabel" />
                                </StackPanel>
                                <Button.KeyboardAccelerators>
                                    <KeyboardAccelerator Modifiers="Control,Shift" Key="S" />
                                </Button.KeyboardAccelerators>
                            </Button>
                            <TextBlock x:Name="ZoomText"
                                       Text="100%"
                                       Width="52"
                                       TextAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Button x:Name="FitToWindowButton" Click="FitToWindowClick">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <SymbolIcon Symbol="FullScreen" />
                                    <TextBlock x:Name="FitToWindowLabel" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="ActualSizeButton" Click="ActualSizeClick" Content="1:1" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- right: recognized text -->
            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Grid, not a StackPanel: the voice picker has to give up width as the pane
                         narrows, otherwise the fixed-width row overflows the card and the trailing
                         buttons get clipped. -->
                    <Border Style="{StaticResource CardToolbarStyle}" BorderThickness="0,0,0,1">
                        <Grid ColumnSpacing="6" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ComboBox x:Name="VoiceComboBox"
                                      MinWidth="96"
                                      HorizontalAlignment="Stretch"
                                      SelectionChanged="VoiceSelectionChanged"
                                      DisplayMemberPath="DisplayName" />

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                <Button x:Name="SpeakButton" Click="SpeakClick">
                                    <SymbolIcon Symbol="Play" />
                                </Button>
                                <Button x:Name="StopSpeakButton" Click="StopSpeakClick">
                                    <SymbolIcon Symbol="Stop" />
                                </Button>

                                <Border Width="1" Margin="2,4"
                                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                <Button x:Name="CopyTextButton" Click="CopyTextClick">
                                    <SymbolIcon Symbol="Copy" />
                                    <Button.KeyboardAccelerators>
                                        <KeyboardAccelerator Modifiers="Control,Shift" Key="C" />
                                    </Button.KeyboardAccelerators>
                                </Button>
                                <Button x:Name="RemoveLineBreaksButton" Click="RemoveLineBreaksClick" />
                                <Button x:Name="RemoveSpacesButton" Click="RemoveSpacesClick" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBox x:Name="ResultTextBox"
                             Grid.Row="1"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             IsSpellCheckEnabled="False"
                             BorderThickness="0"
                             Background="Transparent"
                             Padding="10"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" />
                </Grid>
            </Border>
        </Grid>

        <!-- status -->
        <InfoBar x:Name="StatusBar"
                 Grid.Row="2"
                 Margin="14,10,14,0"
                 IsOpen="False"
                 IsClosable="True" />

        <!-- action bar -->
        <Grid Grid.Row="3" Padding="14,10,14,14" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Button x:Name="OpenButton" Click="OpenClick">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <SymbolIcon Symbol="OpenFile" />
                        <TextBlock x:Name="OpenLabel" />
                    </StackPanel>
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="O" />
                    </Button.KeyboardAccelerators>
                </Button>
                <!-- A SplitButton rather than a DropDownButton: region capture is what all but a
                     few presses want, and it stays one click. Full screen is a mode, not a peer,
                     so it lives behind the arrow next to the shortcut that also invokes it. -->
                <SplitButton x:Name="CaptureButton" Click="CaptureSplitClick">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <SymbolIcon Symbol="Camera" />
                        <TextBlock x:Name="CaptureLabel" />
                    </StackPanel>
                    <SplitButton.Flyout>
                        <MenuFlyout x:Name="CaptureMenu" Placement="Top">
                            <MenuFlyoutItem x:Name="CaptureRegionItem" Click="CaptureRegionClick">
                                <MenuFlyoutItem.Icon>
                                    <SymbolIcon Symbol="Crop" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="CaptureFullScreenItem" Click="CaptureFullScreenClick">
                                <MenuFlyoutItem.Icon>
                                    <SymbolIcon Symbol="FullScreen" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </SplitButton.Flyout>
                </SplitButton>
                <!-- Ctrl+V only reaches this button when the focused control has not already
                     claimed it, so pasting text into the result box still works normally. -->
                <Button x:Name="PasteButton" Click="PasteClick">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <SymbolIcon Symbol="Paste" />
                        <TextBlock x:Name="PasteLabel" />
                    </StackPanel>
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="V" />
                    </Button.KeyboardAccelerators>
                </Button>
                <Button x:Name="HistoryButton">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <SymbolIcon Symbol="Clock" />
                        <TextBlock x:Name="HistoryLabel" />
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout Placement="Top">
                            <Grid x:Name="HistoryFlyoutRoot" Width="420" Height="340">
                                <ListView x:Name="HistoryListView"
                                          SelectionChanged="HistorySelectionChanged">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="local:HistoryItem">
                                            <StackPanel Padding="0,6" Spacing="2">
                                                <TextBlock Text="{x:Bind Header}"
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{x:Bind Preview}"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxLines="2"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <TextBlock x:Name="HistoryEmptyText"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <Button x:Name="SettingsButton">
                    <SymbolIcon Symbol="Setting" />
                    <Button.Flyout>
                        <Flyout Placement="Top">
                            <!-- Scrolls because the option descriptions are long and there are now
                                 four of them: at 150% on a 1080p screen the unscrolled panel is
                                 taller than the space above the button. -->
                            <ScrollViewer MaxHeight="520"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollMode="Disabled">
                                <StackPanel x:Name="SettingsFlyoutRoot" Width="320" Spacing="4">
                                    <TextBlock x:Name="SettingsHeaderText"
                                               Style="{StaticResource BodyStrongTextBlockStyle}"
                                               Margin="0,0,0,4" />
                                    <ComboBox x:Name="UiLanguageComboBox"
                                              HorizontalAlignment="Stretch"
                                              DisplayMemberPath="DisplayName"
                                              SelectionChanged="UiLanguageSelectionChanged" />
                                    <Border Height="1" Margin="0,10"
                                            Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                    <ToggleSwitch x:Name="StartupToggle"
                                                  Toggled="StartupToggled" />
                                    <TextBlock x:Name="StartupDescription"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                    <Border x:Name="StartupSeparator" Height="1" Margin="0,10"
                                            Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                    <ToggleSwitch x:Name="CloseToTrayToggle"
                                                  Toggled="CloseToTrayToggled" />
                                    <TextBlock x:Name="CloseToTrayDescription"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                    <Border Height="1" Margin="0,10"
                                            Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                    <ToggleSwitch x:Name="RepairVersionsToggle"
                                                  Toggled="RepairVersionsToggled" />
                                    <TextBlock x:Name="RepairVersionsDescription"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                    <Border Height="1" Margin="0,10"
                                            Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                    <!-- Only an entry point, not the content: the panel above is
                                         already taller than the space it opens into, and version,
                                         links and rating belong in a dialog anyway. -->
                                    <HyperlinkButton x:Name="AboutButton"
                                                     Margin="-12,0,-12,0"
                                                     Click="AboutClick" />
                                </StackPanel>
                            </ScrollViewer>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <ComboBox x:Name="LanguageComboBox"
                          Width="200"
                          DisplayMemberPath="DisplayName"
                          SelectionChanged="OcrLanguageSelectionChanged" />
                <DropDownButton x:Name="TranslateButton" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <SymbolIcon Symbol="Globe" />
                        <TextBlock x:Name="TranslateLabel" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <MenuFlyout x:Name="TranslateMenu" Placement="Top" />
                    </DropDownButton.Flyout>
                </DropDownButton>
                <Button x:Name="BarcodeButton" Click="ScanBarcodeClick">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <SymbolIcon Symbol="Scan" />
                        <TextBlock x:Name="BarcodeLabel" />
                    </StackPanel>
                </Button>
                <Button x:Name="RecognizeButton" Click="RunClick" Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ProgressRing x:Name="BusyRing" Width="16" Height="16"
                                      IsActive="False" Visibility="Collapsed" />
                        <SymbolIcon x:Name="RecognizeIcon" Symbol="Find" />
                        <TextBlock x:Name="RecognizeLabel" />
                    </StackPanel>
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F5" />
                    </Button.KeyboardAccelerators>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Anchored on the settings button on purpose: once this has been dismissed, the permanent
             way to rate is behind About, which lives exactly where the tip was pointing. -->
        <TeachingTip x:Name="RatingTip"
                     Target="{x:Bind SettingsButton}"
                     PreferredPlacement="Top"
                     ActionButtonClick="RatingTipAction"
                     CloseButtonClick="RatingTipClose" />
    </Grid>
</Window>
