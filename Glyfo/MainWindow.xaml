<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Glyfo.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Glyfo"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Glyfo">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <!-- Every user-visible string here is assigned from the string tables in ApplyLanguage(), so
         that switching language takes effect without rebuilding the window. Nothing in this file
         carries display text of its own. -->
    <Grid x:Name="RootGrid">
        <Grid.Resources>
            <Style x:Key="CardBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
            <Style x:Key="CardToolbarStyle" TargetType="Border">
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="Padding" Value="8,6" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- title bar -->
        <Grid x:Name="AppTitleBar" Height="40" Padding="14,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE721;" FontSize="14" />
                <TextBlock Text="Glyfo" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                <TextBlock x:Name="EngineStatusText"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- two panes -->
        <Grid Grid.Row="1" Margin="14,4,14,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- left: image preview -->
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer x:Name="PreviewScrollViewer"
                                  ZoomMode="Enabled"
                                  MinZoomFactor="0.1"
                                  MaxZoomFactor="8"
                                  HorizontalScrollMode="Auto"
                                  VerticalScrollMode="Auto"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalContentAlignment="Center"
                                  VerticalContentAlignment="Center"
                                  ViewChanged="PreviewViewChanged"
                                  SizeChanged="PreviewSizeChanged"
                                  AllowDrop="True"
                                  DragOver="PreviewDragOver"
                                  Drop="PreviewDrop"
                                  CornerRadius="8,8,0,0">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Image x:Name="PreviewImage" Stretch="None" Visibility="Collapsed" />
                            <StackPanel x:Name="PreviewPlaceholder"
                                        Spacing="10"
                                        Padding="24"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE91B;" FontSize="30"
                                          Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <TextBlock x:Name="PreviewPlaceholderText"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>

                    <!-- Floats over the viewport rather than sitting in the toolbar below, which at
                         half the window's width already carries five buttons and would clip. A
                         sibling of the ScrollViewer, not a child: inside it the pill would scroll
                         away with the page and zoom along with it. -->
                    <Border x:Name="PdfNavBar"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,14"
                            Padding="4"
                            CornerRadius="16"
                            Visibility="Collapsed"
                            Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                            <Button x:Name="PdfPrevButton" Click="PdfPrevClick"
                                    Background="Transparent" BorderThickness="0"
                                    CornerRadius="14" Padding="10,4">
                                <FontIcon Glyph="&#xE76B;" FontSize="12" />
                            </Button>
                            <TextBlock x:Name="PdfPageText"
                                       MinWidth="64"
                                       TextAlignment="Center"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource CaptionTextBlockStyle}" />
                            <Button x:Name="PdfNextButton" Click="PdfNextClick"
                                    Background="Transparent" BorderThickness="0"
                                    CornerRadius="14" Padding="10,4">
                                <FontIcon Glyph="&#xE76C;" FontSize="12" />
                            </Button>

                            <!-- Reading the whole document is a different kind of act from turning a
                                 page, so the rule separates it: a misfire here costs minutes, not a
                                 redraw. -->
                            <Rectangle Width="1" Height="16" Margin="4,0"
                                       VerticalAlignment="Center"
                                       Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            <Button x:Name="PdfAllButton" Click="PdfAllClick"
                                    Background="Transparent" BorderThickness="0"
                                    CornerRadius="14" Padding="10,4">
                                <FontIcon Glyph="&#xE8A5;" FontSize="12" />
                            </Button>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource CardToolbarStyle}" BorderThickness="0,1,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Button x:Name="CopyImageButton" Click="CopyImageClick">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <SymbolIcon Symbol="Copy" />
                                    <TextBlock x:Name="CopyImageLabel" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="SaveImageButton" Click="SaveImageClick">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <SymbolIcon Symbol="Save" />
                                    <TextBlock x:Name="SaveImageLabel" />
                                </StackPanel>
                                <Button.KeyboardAccelerators>
                                    <KeyboardAccelerator Modifiers="Control,Shift" Key="S" />
                                </Button.KeyboardAccelerators>
                            </Button>
                            <!-- Icon only, unlike its two neighbours: this row has to survive the
                                 1060px minimum width, and a fourth label would push the zoom
                                 controls off the card. Same shape as the capture button — the one
                                 turn almost every press wants stays a single click, and the rest
                                 live behind the arrow. -->
                            <SplitButton x:Name="RotateButton" Click="RotateRightClick">
                                <SymbolIcon Symbol="Rotate" />
                                <SplitButton.Flyout>
                                    <MenuFlyout x:Name="RotateMenu">
                                        <MenuFlyoutItem x:Name="RotateLeftItem" Click="RotateLeftClick">
                                            <MenuFlyoutItem.Icon>
                                                <SymbolIcon Symbol="Undo" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Name="RotateHalfItem" Click="RotateHalfClick">
                                            <MenuFlyoutItem.Icon>
                                                <SymbolIcon Symbol="Rotate" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem x:Name="DeskewItem" Click="DeskewClick">
                                            <MenuFlyoutItem.Icon>
                                                <SymbolIcon Symbol="Repair" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Name="RotateResetItem" Click="RotateResetClick">
                                            <MenuFlyoutItem.Icon>
                                                <SymbolIcon Symbol="Refresh" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </SplitButton.Flyout>
                            </SplitButton>
                            <TextBlock x:Name="ZoomText"
                                       Text="100%"
                                       Width="52"
                                       TextAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Button x:Name="FitToWindowButton" Click="FitToWindowClick">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <SymbolIcon Symbol="FullScreen" />
                                    <TextBlock x:Name="FitToWindowLabel" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="ActualSizeButton" Click="ActualSizeClick" Content="1:1" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- right: recognized text -->
            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Grid, not a StackPanel: the voice picker has to give up width as the pane
                         narrows, otherwise the fixed-width row overflows the card and the trailing
                         buttons get clipped. -->
                    <Border Style="{StaticResource CardToolbarStyle}" BorderThickness="0,0,0,1">
                        <Grid ColumnSpacing="6" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ComboBox x:Name="VoiceComboBox"
                                      MinWidth="96"
                                      HorizontalAlignment="Stretch"
                                      SelectionChanged="VoiceSelectionChanged"
                                      DisplayMemberPath="DisplayName" />

                            <!-- Empty until there is text, so an idle window does not read "0 words".
                                 Trimmed rather than wrapped: at the minimum window width this column
                                 is the one with the least to lose. -->
                            <TextBlock x:Name="TextStatsText"
                                       Grid.Column="1"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                                <Button x:Name="SpeakButton" Click="SpeakClick">
                                    <SymbolIcon Symbol="Play" />
                                </Button>
                                <Button x:Name="StopSpeakButton" Click="StopSpeakClick">
                                    <SymbolIcon Symbol="Stop" />
                                </Button>

                                <Border Width="1" Margin="2,4"
                                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                <Button x:Name="CopyTextButton" Click="CopyTextClick">
                                    <SymbolIcon Symbol="Copy" />
                                    <Button.KeyboardAccelerators>
                                        <KeyboardAccelerator Modifiers="Control,Shift" Key="C" />
                                    </Button.KeyboardAccelerators>
                                </Button>
                                <!-- Ctrl+S for the text and Ctrl+Shift+S for the picture, which is
                                     the right way round: the text is what the app is for, and the
                                     picture is what it was read from. -->
                                <Button x:Name="SaveTextButton" Click="SaveTextClick">
                                    <SymbolIcon Symbol="Save" />
                                    <Button.KeyboardAccelerators>
                                        <KeyboardAccelerator Modifiers="Control" Key="S" />
                                    </Button.KeyboardAccelerators>
                                </Button>
                                <Button x:Name="RemoveLineBreaksButton" Click="RemoveLineBreaksClick" />
                                <Button x:Name="RemoveSpacesButton" Click="RemoveSpacesClick" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Between the toolbar and the text, and only there when it is asked for: a
                         search box on screen at all times would cost a line of the result to
                         something most pages never need. -->
                    <Border x:Name="FindBar"
                            Grid.Row="1"
                            Style="{StaticResource CardToolbarStyle}"
                            BorderThickness="0,0,0,1"
                            Visibility="Collapsed">
                        <Grid ColumnSpacing="6" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="FindBox"
                                     TextChanged="FindTextChanged"
                                     KeyDown="FindBoxKeyDown" />
                            <TextBlock x:Name="FindCountText"
                                       Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                                <!-- Chevrons by glyph, because the Symbol enum has no pair of
                                     plain up and down arrows and Download would read as a verb. -->
                                <Button x:Name="FindPrevButton" Click="FindPrevClick">
                                    <FontIcon Glyph="&#xE70E;" FontSize="14" />
                                </Button>
                                <Button x:Name="FindNextButton" Click="FindNextClick">
                                    <FontIcon Glyph="&#xE70D;" FontSize="14" />
                                </Button>
                                <Button x:Name="FindCloseButton" Click="FindCloseClick">
                                    <SymbolIcon Symbol="Cancel" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- SelectionHighlightColorWhenNotFocused is not decoration: while you are typing
                         in the find box the text box does not have focus, and without it every jump
                         would land on a selection nobody can see. -->
                    <TextBox x:Name="ResultTextBox"
                             Grid.Row="2"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             IsSpellCheckEnabled="False"
                             BorderThickness="0"
                             Background="Transparent"
                             Padding="10"
                             SelectionHighlightColorWhenNotFocused="{ThemeResource TextControlSelectionHighlightColor}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             TextChanged="ResultTextChanged"
                             SelectionChanged="ResultSelectionChanged">
                        <TextBox.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="F" Invoked="FindAccelerator" />
                        </TextBox.KeyboardAccelerators>
                    </TextBox>

                    <!-- Below the text, not above it: you read the address before you decide to
                         open it. Hidden entirely when there is nothing to act on, so an ordinary
                         page of prose does not grow an empty strip. -->
                    <Border x:Name="ActionsBar"
                            Grid.Row="3"
                            Style="{StaticResource CardToolbarStyle}"
                            BorderThickness="0,1,0,0"
                            Visibility="Collapsed">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollMode="Disabled"
                                      HorizontalScrollMode="Auto">
                            <StackPanel x:Name="ActionsPanel" Orientation="Horizontal" Spacing="6" />
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- status -->
        <InfoBar x:Name="StatusBar"
                 Grid.Row="2"
                 Margin="14,10,14,0"
                 IsOpen="False"
                 IsClosable="True" />

        <!-- action bar -->
        <Grid Grid.Row="3" Padding="14,10,14,14" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Button x:Name="OpenButton" Click="OpenClick">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <SymbolIcon Symbol="OpenFile" />
                        <TextBlock x:Name="OpenLabel" />
                    </StackPanel>
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="O" />
                    </Button.KeyboardAccelerators>
                </Button>
                <!-- A SplitButton rather than a DropDownButton: region capture is what all but a
                     few presses want, and it stays one click. Full screen is a mode, not a peer,
                     so it lives behind the arrow next to the shortcut that also invokes it. -->
                <SplitButton x:Name="CaptureButton" Click="CaptureSplitClick">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <SymbolIcon Symbol="Camera" />
                        <TextBlock x:Name="CaptureLabel" />
                    </StackPanel>
                    <SplitButton.Flyout>
                        <MenuFlyout x:Name="CaptureMenu" Placement="Top">
                            <MenuFlyoutItem x:Name="CaptureRegionItem" Click="CaptureRegionClick">
                                <MenuFlyoutItem.Icon>
                                    <SymbolIcon Symbol="Crop" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="CaptureFullScreenItem" Click="CaptureFullScreenClick">
                                <MenuFlyoutItem.Icon>
                                    <SymbolIcon Symbol="FullScreen" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </SplitButton.Flyout>
                </SplitButton>
                <!-- Ctrl+V only reaches this button when the focused control has not already
                     claimed it, so pasting text into the result box still works normally. -->
                <Button x:Name="PasteButton" Click="PasteClick">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <SymbolIcon Symbol="Paste" />
                        <TextBlock x:Name="PasteLabel" />
                    </StackPanel>
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="V" />
                    </Button.KeyboardAccelerators>
                </Button>
                <Button x:Name="HistoryButton">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <SymbolIcon Symbol="Clock" />
                        <TextBlock x:Name="HistoryLabel" />
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout Placement="Top">
                            <!-- Bigger than it was, because the list now outlives the session: with
                                 twenty entries you could see most of them at once, with two hundred
                                 the search box is how you get to one and the extra rows are what
                                 make the search worth typing into. -->
                            <Grid x:Name="HistoryFlyoutRoot" Width="460" Height="420" RowSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBox x:Name="HistorySearchBox"
                                             TextChanged="HistorySearchChanged" />
                                    <Button x:Name="HistoryClearButton"
                                            Grid.Column="1"
                                            Click="HistoryClearClick">
                                        <SymbolIcon Symbol="Delete" />
                                    </Button>
                                </Grid>

                                <Grid Grid.Row="1">
                                    <ListView x:Name="HistoryListView"
                                              SelectionChanged="HistorySelectionChanged">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="local:HistoryItem">
                                                <StackPanel Padding="0,6" Spacing="2">
                                                    <!-- Right-click rather than buttons on the row:
                                                         copy and delete are both occasional, and two
                                                         icons per row would crowd out the preview
                                                         text that makes the row findable. -->
                                                    <StackPanel.ContextFlyout>
                                                        <MenuFlyout Opening="HistoryItemMenuOpening">
                                                            <MenuFlyoutItem Click="HistoryCopyItemClick">
                                                                <MenuFlyoutItem.Icon>
                                                                    <SymbolIcon Symbol="Copy" />
                                                                </MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                            <MenuFlyoutItem Click="HistoryDeleteItemClick">
                                                                <MenuFlyoutItem.Icon>
                                                                    <SymbolIcon Symbol="Delete" />
                                                                </MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                        </MenuFlyout>
                                                    </StackPanel.ContextFlyout>
                                                    <TextBlock Text="{x:Bind Header}"
                                                               Style="{StaticResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Text="{x:Bind Preview}"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxLines="2"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                    <TextBlock x:Name="HistoryEmptyText"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               Margin="24,0"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </Grid>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <!-- A dialog rather than a flyout since 1.3.0: the options outgrew the space above
                     the button, and shortcuts and theme were about to make it worse. The content
                     itself is declared below, at the end of the root grid. -->
                <Button x:Name="SettingsButton" Click="SettingsClick">
                    <SymbolIcon Symbol="Setting" />
                </Button>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <ComboBox x:Name="LanguageComboBox"
                          Width="200"
                          DisplayMemberPath="DisplayName"
                          SelectionChanged="OcrLanguageSelectionChanged" />
                <DropDownButton x:Name="TranslateButton" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <SymbolIcon Symbol="Globe" />
                        <TextBlock x:Name="TranslateLabel" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <MenuFlyout x:Name="TranslateMenu" Placement="Top" />
                    </DropDownButton.Flyout>
                </DropDownButton>
                <Button x:Name="BarcodeButton" Click="ScanBarcodeClick">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <SymbolIcon Symbol="Scan" />
                        <TextBlock x:Name="BarcodeLabel" />
                    </StackPanel>
                </Button>
                <Button x:Name="RecognizeButton" Click="RunClick" Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ProgressRing x:Name="BusyRing" Width="16" Height="16"
                                      IsActive="False" Visibility="Collapsed" />
                        <SymbolIcon x:Name="RecognizeIcon" Symbol="Find" />
                        <TextBlock x:Name="RecognizeLabel" />
                    </StackPanel>
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F5" />
                    </Button.KeyboardAccelerators>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Anchored on the settings button on purpose: once this has been dismissed, the permanent
             way to rate is behind About, which lives exactly where the tip was pointing. -->
        <TeachingTip x:Name="RatingTip"
                     Target="{x:Bind SettingsButton}"
                     PreferredPlacement="Top"
                     ActionButtonClick="RatingTipAction"
                     CloseButtonClick="RatingTipClose" />

        <!-- Declared in the tree rather than built in code, unlike the dialogs in AppDialogs: these
             controls are the ones ApplyLanguage writes to by name. A ContentDialog's template is
             collapsed until ShowAsync, so sitting in the grid's first cell costs nothing; its
             children are real from InitializeComponent onwards, which is what lets ApplyLanguage
             reach them long before the dialog is first opened. -->
        <ContentDialog x:Name="SettingsDialog" DefaultButton="Close">
            <ContentDialog.Resources>
                <!-- Setting MaxWidth on the dialog does nothing: the default template's
                     BackgroundElement reads ContentDialogMaxWidth as a resource rather than
                     template-binding the property, so the 548 wins and the content is clipped
                     rather than the dialog widened. Redefining the key here puts it in the lookup
                     chain the template walks. 180 + 16 + 400 of columns plus the dialog's own
                     padding needs about 650. -->
                <x:Double x:Key="ContentDialogMaxWidth">680</x:Double>
                <!-- The Windows 11 settings row: a bordered card holding a title, the control that
                     changes it, and — where there is one — the sentence explaining what it does. -->
                <Style x:Key="SettingsCardStyle" TargetType="Border">
                    <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
                    <Setter Property="Padding" Value="16,12" />
                </Style>
            </ContentDialog.Resources>
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="400" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- A plain ListView rather than NavigationView: inside a fixed-size dialog the
                     latter's hamburger, pane header and automatic display-mode collapse are all
                     liability. Down the side rather than across the top because the four group
                     names run to sixty-odd characters in Ukrainian and Russian — a horizontal
                     strip neither wraps nor scrolls, so those languages would simply clip. The
                     headings themselves are the same TextBlocks as before, only rehoused, so
                     ApplyLanguage still writes them by name. -->
                <!-- No SelectedIndex here: setting it in the markup raises SelectionChanged while
                     the parser is still on this element, and the four pages it wants to show and
                     hide are further down the file and do not exist yet. The constructor selects
                     the first item once the tree is built. -->
                <ListView x:Name="SettingsNavList"
                          VerticalAlignment="Top"
                          SelectionMode="Single"
                          SelectionChanged="SettingsNavSelectionChanged">
                    <ListViewItem x:Name="SettingsNavGeneral" HorizontalContentAlignment="Stretch">
                        <TextBlock x:Name="SettingsGroupGeneral" TextWrapping="Wrap" />
                    </ListViewItem>
                    <ListViewItem x:Name="SettingsNavHotkeys" HorizontalContentAlignment="Stretch">
                        <TextBlock x:Name="SettingsGroupHotkeys" TextWrapping="Wrap" />
                    </ListViewItem>
                    <ListViewItem x:Name="SettingsNavRecognition" HorizontalContentAlignment="Stretch">
                        <TextBlock x:Name="SettingsGroupRecognition" TextWrapping="Wrap" />
                    </ListViewItem>
                    <ListViewItem x:Name="SettingsNavPrivacy" HorizontalContentAlignment="Stretch">
                        <TextBlock x:Name="SettingsGroupPrivacy" TextWrapping="Wrap" />
                    </ListViewItem>
                </ListView>

                <!-- Measured: General runs 447, Privacy 298, Hotkeys 247, Recognition 140. The
                     MinHeight settles the bottom three at one height so only General changes the
                     dialog's size, and the MaxHeight sits above General so nothing scrolls at the
                     default text size. It stays well under what fits in a 640-tall window, which is
                     the smallest this one can be made — a MinHeight tall enough to also cover
                     General would not fit there. -->
                <ScrollViewer Grid.Column="1"
                              MinHeight="320"
                              MaxHeight="460"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollMode="Disabled">
                    <!-- The four pages share one cell and take turns being visible. Not a Frame
                         with page classes: every one of these controls is written by name from
                         ApplyLanguage, which runs long before the dialog is first shown, so they
                         all have to exist from InitializeComponent onwards. -->
                    <Grid>
                        <StackPanel x:Name="SettingsPageGeneral" Spacing="8">
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="UiLanguageTitle"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap" />
                                    <ComboBox x:Name="UiLanguageComboBox"
                                              Grid.Column="1"
                                              MinWidth="200"
                                              DisplayMemberPath="DisplayName"
                                              SelectionChanged="UiLanguageSelectionChanged" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="ThemeTitle"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap" />
                                    <ComboBox x:Name="ThemeComboBox"
                                              Grid.Column="1"
                                              MinWidth="200"
                                              SelectionChanged="ThemeSelectionChanged" />
                                </Grid>
                            </Border>
                            <!-- The description runs the full width of the card rather than sharing
                                 the title's column: a ToggleSwitch with its On/Off text is 154 wide,
                                 which would leave the sentence under 200 and send the German ones to
                                 five lines. Underneath, it gets the whole card and the card is
                                 shorter for it. -->
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel Spacing="4">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="StartupTitle"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap" />
                                        <ToggleSwitch x:Name="StartupToggle"
                                                      Grid.Column="1"
                                                      Toggled="StartupToggled" />
                                    </Grid>
                                    <TextBlock x:Name="StartupDescription"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel Spacing="4">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="CloseToTrayTitle"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap" />
                                        <ToggleSwitch x:Name="CloseToTrayToggle"
                                                      Grid.Column="1"
                                                      Toggled="CloseToTrayToggled" />
                                    </Grid>
                                    <TextBlock x:Name="CloseToTrayDescription"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="SettingsPageHotkeys" Spacing="8" Visibility="Collapsed">
                            <!-- The button is the value: it shows the combination registered right
                                 now, and pressing it records over that one in place. A label reading
                                 "Alt+Z" with an "Edit" button beside it would say the same thing in
                                 twice the width, and recording in a second dialog is not open to us
                                 — WinUI will not stack one ContentDialog on another, and this panel
                                 is itself inside a dialog. -->
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="HotkeyRegionLabel"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap" />
                                    <Button x:Name="HotkeyRegionButton"
                                            Grid.Column="1"
                                            MinWidth="150"
                                            Click="HotkeyRegionClick"
                                            PreviewKeyDown="HotkeyRecordKeyDown"
                                            LostFocus="HotkeyRecordLostFocus" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="HotkeyFullLabel"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap" />
                                    <Button x:Name="HotkeyFullButton"
                                            Grid.Column="1"
                                            MinWidth="150"
                                            Click="HotkeyFullClick"
                                            PreviewKeyDown="HotkeyRecordKeyDown"
                                            LostFocus="HotkeyRecordLostFocus" />
                                </Grid>
                            </Border>
                            <!-- Outside the cards, because both speak to the page rather than to
                                 either row: the hint explains recording, the link resets both. -->
                            <TextBlock x:Name="HotkeyHint"
                                       Margin="4,4,4,0"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" />
                            <HyperlinkButton x:Name="ResetHotkeysButton"
                                             Margin="-7,0,0,0"
                                             Click="ResetHotkeysClick" />
                        </StackPanel>

                        <StackPanel x:Name="SettingsPageRecognition" Spacing="8" Visibility="Collapsed">
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel Spacing="4">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="RepairVersionsTitle"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap" />
                                        <ToggleSwitch x:Name="RepairVersionsToggle"
                                                      Grid.Column="1"
                                                      Toggled="RepairVersionsToggled" />
                                    </Grid>
                                    <TextBlock x:Name="RepairVersionsDescription"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="SettingsPagePrivacy" Spacing="8" Visibility="Collapsed">
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel Spacing="4">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="WatchClipboardTitle"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap" />
                                        <ToggleSwitch x:Name="WatchClipboardToggle"
                                                      Grid.Column="1"
                                                      Toggled="WatchClipboardToggled" />
                                    </Grid>
                                    <!-- Two sentences, and both have to stay. The first says the
                                         copied picture is replaced by its text, which is the one
                                         surprising thing this does; the second says the picture
                                         never leaves the machine, which is what anyone reading
                                         "watches your clipboard" wants to know next. -->
                                    <TextBlock x:Name="WatchClipboardDescription"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel Spacing="4">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="KeepHistoryTitle"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap" />
                                        <ToggleSwitch x:Name="KeepHistoryToggle"
                                                      Grid.Column="1"
                                                      Toggled="KeepHistoryToggled" />
                                    </Grid>
                                    <!-- Says what is stored, what is not, and what turning it off
                                         does. The third part matters as much as the first: a switch
                                         that only stopped future writes would leave what is already
                                         on disk behind, which is not what anyone reaching for it
                                         means. -->
                                    <TextBlock x:Name="KeepHistoryDescription"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- Across the foot rather than a fifth navigation item: it is an entry point, not
                     a page. Version, links and rating are their own dialog, and this one cannot
                     open a second on top of itself — it closes first. -->
                <HyperlinkButton x:Name="AboutButton"
                                 Grid.Row="1"
                                 Grid.ColumnSpan="2"
                                 HorizontalAlignment="Left"
                                 Margin="-7,12,0,0"
                                 Click="AboutClick" />
            </Grid>
        </ContentDialog>
    </Grid>
</Window>
