<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Glyfo.RegionCaptureWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Capture Region">

    <Grid x:Name="RootGrid"
          PointerPressed="RootGrid_PointerPressed"
          PointerMoved="RootGrid_PointerMoved"
          PointerReleased="RootGrid_PointerReleased"
          RightTapped="RootGrid_RightTapped"
          KeyDown="RootGrid_KeyDown"
          IsTabStop="True">
        <!-- Frozen screenshot, so the user selects against exactly the pixels that get cropped. -->
        <Image x:Name="BackdropImage" Stretch="Fill" />
        <Grid Background="#66000000" />
        <Canvas>
            <Border x:Name="SelectionBorder"
                    Visibility="Collapsed"
                    BorderBrush="#FFFFFF"
                    BorderThickness="2"
                    Background="#22FFFFFF" />
            <!-- Text set from the string table in the constructor. -->
            <TextBlock x:Name="HintText"
                       Foreground="White"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Canvas.Left="28"
                       Canvas.Top="22" />
        </Canvas>
    </Grid>
</Window>
