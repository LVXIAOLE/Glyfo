<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <!-- 19041, not 17763: the share-target contract for packaged desktop apps only exists from
         Windows 10 2004 onwards, and declaring a floor the app cannot actually honour would put
         Glyfo in the Store for machines where its share entry silently does nothing. -->
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>Glyfo</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Embedded as Win32 resource 32512 (IDI_APPLICATION). That is what Explorer draws for the
         .exe, what the window gets by default, and what TrayIcon loads at the shell's small-icon
         size. Generated by tools\Generate-Icons.ps1 from the same artwork as the packaged images. -->
    <ApplicationIcon>Assets\Glyfo.ico</ApplicationIcon>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.1.3" />

    <!-- The meta-package drags in ML (-> Microsoft.Windows.AI.MachineLearning), which ships
         onnxruntime.dll (21MB) + DirectML.dll (18MB). We never touch Microsoft.Windows.AI.MachineLearning:
         our Copilot+ path uses TextRecognizer / LanguageModel from the AI package, which depends
         only on Base + Foundation. Widgets is unused too. Declaring them directly with
         ExcludeAssets="all" overrides the transitive pull without desyncing the meta-package version. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.ML" Version="2.1.1" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.Windows.AI.MachineLearning" Version="2.1.1" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Widgets" Version="2.0.5" ExcludeAssets="all" />

    <!-- Kept for screen capture (Graphics.CopyFromScreen), region cropping, and the rotate and
         straighten pass in Services\ImageOps.cs. -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
    <!-- Apache 2.0, redistributable in a Store package. Core package only: the
         Windows.Compatibility flavour would drag in another System.Drawing binding layer. -->
    <PackageReference Include="ZXing.Net" Version="0.16.10" />
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

    <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <!-- Trimming is the single biggest size lever here: Microsoft.Windows.SDK.NET.dll alone is
         24MB untrimmed and 0.3MB trimmed. TrimMode=partial, not the .NET 8 default of full: BCL and
         CsWinRT assemblies are marked IsTrimmable and get member-level trimming, while our own code
         and zxing.dll are kept whole.
         Keep this unconditional. NuGet only puts Microsoft.NET.ILLink.Tasks in the assets file when
         the property is true at *restore* time, so a Configuration-conditioned value would silently
         skip trimming on any publish whose restore ran under the other configuration.

         It is NOT free of risk: x:Bind keeps the XAML side trim-visible, but anything that crosses
         the WinRT boundary as a managed object is resolved reflectively and is invisible to the
         trimmer. ILLink.Descriptors.xml below lists what has to survive; read it before touching
         any of this. The failure mode is a crash on the first launch of a packaged build, with a
         clean build log. -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <!-- Emits CCW vtables at compile time where CsWinRT can see the conversion statically, which
         is fewer places than one would hope — it does not cover ObservableCollection<T>, hence the
         descriptor. Harmless and slightly faster, so left on. -->
    <CsWinRTAotOptimizerEnabled>true</CsWinRTAotOptimizerEnabled>
  </PropertyGroup>

  <ItemGroup>
    <TrimmerRootDescriptor Include="ILLink.Descriptors.xml" />
  </ItemGroup>
</Project>
