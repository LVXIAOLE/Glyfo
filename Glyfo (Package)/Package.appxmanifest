<?xml version="1.0" encoding="utf-8"?>

<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:systemai="http://schemas.microsoft.com/appx/manifest/systemai/windows10"
  IgnorableNamespaces="uap rescap systemai">

  <!--
    Reserved in Partner Center. Name and Publisher have to match the values there byte for byte
    or the upload is rejected, and Name is permanent from the moment the first submission is
    accepted — the Store keys the product's identity off it forever. The display name above it
    is the part that can still be changed later.

    Version has to climb with every upload — Partner Center refuses a package whose version already
    exists in the submission, so 1.0.0.0 is spent even though it never reached anyone.
  -->
  <Identity
    Name="LVLE.Glyfo"
    Publisher="CN=B8B25EFA-5CE4-4BE4-A5CC-360E7B53648F"
    Version="1.3.0.0" />

  <Properties>
    <DisplayName>Glyfo</DisplayName>
    <PublisherDisplayName>LVLE</PublisherDisplayName>
    <Logo>Images\StoreLogo.png</Logo>
  </Properties>

  <!--
    Desktop only. The Windows.Universal entry came from the project template and never meant
    anything here: the app is a full-trust Win32 process and cannot run anywhere else.

    19041 rather than 17763, because share-target activation for packaged desktop apps starts at
    Windows 10 2004. Installing on 1809/1903 would produce an app whose share entry is dead.
  -->
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26226.0" />
  </Dependencies>

  <!--
    x-generate, and it has to stay that way: the packaging targets overwrite this element on every
    build from the qualifiers MakePri collected, so languages written here by hand simply vanish.
    What it expands to is decided by Strings\<tag>\Resources.resw in this project — see the
    PRIResource item in the .wapproj. All thirty-three interface languages should come out here;
    if the built package only says EN-US, those files stopped being indexed.
  -->
  <Resources>
    <Resource Language="x-generate"/>
  </Resources>

  <Applications>
    <Application Id="App"
      Executable="$targetnametoken$.exe"
      EntryPoint="$targetentrypoint$">
      <uap:VisualElements
        DisplayName="Glyfo"
        Description="Extract text from images and screenshots with the OCR built into Windows. Reads QR codes and barcodes, and translates on Copilot+ PCs without going online."
        BackgroundColor="transparent"
        Square150x150Logo="Images\Square150x150Logo.png"
        Square44x44Logo="Images\Square44x44Logo.png">
        <uap:DefaultTile
          Square71x71Logo="Images\Square71x71Logo.png"
          Square310x310Logo="Images\Square310x310Logo.png"
          Wide310x150Logo="Images\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Images\SplashScreen.png" />
      </uap:VisualElements>

      <!--
        The notification activator. Without these two entries AppNotificationManager.Register()
        fails with 0x80004005 "No COM servers are registered for this app" and every toast is
        silently dropped — package identity alone is not enough.

        The executable path is the one the packaging targets lay down for the app project; it is
        written out rather than tokenized because $targetnametoken$ is only substituted in the
        Application element. The CLSID is arbitrary but must never change: it is how the shell
        calls back into the app when a notification is clicked, and the two entries must agree.
      -->
      <Extensions>
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:ExeServer Executable="Glyfo\Glyfo.exe" DisplayName="Glyfo" Arguments="----AppNotificationActivated:">
              <com:Class Id="43746AD2-E7FF-487E-BCDE-EAC7DDF9861F" DisplayName="Glyfo notification activator" />
            </com:ExeServer>
          </com:ComServer>
        </com:Extension>
        <!-- desktop:, not uap:: the uap enumeration of extension categories has no entry for this
             one, which is a packaged-desktop-app extension. -->
        <desktop:Extension Category="windows.toastNotificationActivation">
          <desktop:ToastNotificationActivation ToastActivatorCLSID="43746AD2-E7FF-487E-BCDE-EAC7DDF9861F" />
        </desktop:Extension>

        <!--
          Start with Windows. Enabled="false" is deliberate and required: the user turns this on
          from the options flyout, which is what StartupTask.RequestEnableAsync is for. An app that
          shipped enabled would be adding itself to every sign-in without being asked.

          TaskId is the argument passed to StartupTask.GetAsync. Changing it creates a different
          task, silently discarding whatever the user had chosen for the old one.
        -->
        <uap5:Extension
          Category="windows.startupTask"
          Executable="Glyfo\Glyfo.exe"
          EntryPoint="Windows.FullTrustApplication">
          <uap5:StartupTask TaskId="GlyfoStartup" Enabled="false" DisplayName="Glyfo" />
        </uap5:Extension>

        <!--
          Puts Glyfo in Explorer's "Open with" list for the formats ImageLoader can actually
          read — the same set as MainWindow.SupportedExtensions. It does not claim the default
          handler for any of them; Windows reserves that choice for the user regardless.

          Name must be lower case with no dots. It is an identifier, not a display string.
        -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="glyfoimage">
            <uap:DisplayName>Image</uap:DisplayName>
            <uap:Logo>Images\Square44x44Logo.png</uap:Logo>
            <uap:SupportedFileTypes>
              <uap:FileType>.png</uap:FileType>
              <uap:FileType>.jpg</uap:FileType>
              <uap:FileType>.jpeg</uap:FileType>
              <uap:FileType>.bmp</uap:FileType>
              <uap:FileType>.gif</uap:FileType>
              <uap:FileType>.tif</uap:FileType>
              <uap:FileType>.tiff</uap:FileType>
              <uap:FileType>.webp</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>

        <!--
          A second association rather than another FileType inside glyfoimage. Renaming or
          re-scoping an association that has already shipped resets the default-program choices
          users made against it, and a PDF is not an image anyway — Explorer shows this one its
          own display name.
        -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="glyfopdf">
            <uap:DisplayName>PDF document</uap:DisplayName>
            <uap:Logo>Images\Square44x44Logo.png</uap:Logo>
            <uap:SupportedFileTypes>
              <uap:FileType>.pdf</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>

        <!--
          The Windows share sheet. Both payload shapes are accepted because both occur in practice:
          Explorer and the Photos app share a StorageItem, while Snipping Tool and browsers hand
          over a Bitmap with no file behind it.

          SupportedFileTypes has to precede DataFormat — the schema is a sequence, not a choice,
          and swapping them fails packaging with APPX0501.
        -->
        <uap:Extension Category="windows.shareTarget">
          <uap:ShareTarget>
            <uap:SupportedFileTypes>
              <uap:FileType>.png</uap:FileType>
              <uap:FileType>.jpg</uap:FileType>
              <uap:FileType>.jpeg</uap:FileType>
              <uap:FileType>.bmp</uap:FileType>
              <uap:FileType>.gif</uap:FileType>
              <uap:FileType>.tif</uap:FileType>
              <uap:FileType>.tiff</uap:FileType>
              <uap:FileType>.webp</uap:FileType>
              <uap:FileType>.pdf</uap:FileType>
            </uap:SupportedFileTypes>
            <uap:DataFormat>Bitmap</uap:DataFormat>
            <uap:DataFormat>StorageItems</uap:DataFormat>
          </uap:ShareTarget>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <systemai:Capability Name="systemAIModels"/>
  </Capabilities>
</Package>
